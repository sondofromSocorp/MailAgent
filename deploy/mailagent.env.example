# Copie ce fichier vers /etc/mailagent.env (chmod 600, proprietaire root) et remplis les valeurs.
# Ce sont les mymes secrets que les GitHub Secrets du workflow CI.

IMAP_USER=ton.adresse@gmail.com
IMAP_PASS=mot_de_passe_application_16_car

# Boite "pro" (voir Accounts dans appsettings.json). Vide = boite simplement sautee.
IMAP_USER_PRO=
IMAP_PASS_PRO=
TELEGRAM_BOT_TOKEN=123456:ABC-...
TELEGRAM_CHAT_ID=1234567890

# LLM : cascade cloud gratuite d'abord (rapide, plus fine), Ollama LOCAL en dernier recours
# quand les quotas sont epuises ou le reseau indisponible. Renseigner les cles ci-dessous.
# (Alternative 100 % locale sans cle : Llm__Provider=ollama et retirer OllamaFallback.)
Llm__Provider=free
Free__OllamaFallback=true
GEMINI_API_KEY=
GROQ_API_KEY=

# Optionnel - agenda auto (laisser vide si non configure) :
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
