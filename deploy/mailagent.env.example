# Copie ce fichier vers /etc/mailagent.env (chmod 600, proprietaire root) et remplis les valeurs.
# Ce sont les mymes secrets que les GitHub Secrets du workflow CI.

IMAP_USER=ton.adresse@gmail.com
IMAP_PASS=mot_de_passe_application_16_car
TELEGRAM_BOT_TOKEN=123456:ABC-...
TELEGRAM_CHAT_ID=1234567890

# LLM local : pas de cle API necessaire.
Llm__Provider=ollama

# Optionnel - agenda auto (laisser vide si non configure) :
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
